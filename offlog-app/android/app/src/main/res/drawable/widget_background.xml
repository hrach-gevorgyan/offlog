<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own surface color, not the accent (see colors.xml's
     colorWidget* group). colorWidget* has a values-night/ override, so the
     widget follows the OS light/dark setting rather than the app's own
     in-app theme, which it cannot read. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/colorWidgetBg" />
    <corners android:radius="20dp" />
</shape>
