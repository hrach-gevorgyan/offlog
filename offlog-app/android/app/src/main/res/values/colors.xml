<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorPrimary">#575fca</color>
    <color name="colorPrimaryDark">#181a20</color>
    <color name="colorAccent">#575fca</color>
    <!-- Launch splash: app.css hero token, so the splash hands over to the phone
         Home's hero band (and the purple loading screen) without a flash. -->
    <color name="splashBg">#575fca</color>

    <!-- Widget palette, matched to app.css's tokens. This file is the
         LIGHT set; the dark set is values-night/colors.xml. A widget
         renders outside the app's in-app theme setting, so it follows the
         system light/dark setting instead — both files must stay in sync
         with app.css's :root / body.dark blocks (docs/tech.md's Theme
         System table is the source of truth). -->
    <!-- Calm and neutral: the card and one quieter button shade, text-coloured
         glyphs, and the accent only on the Focus mark. The button shade
         must stay a clearly visible step from colorWidgetBg or the buttons
         stop reading as separate from the card. -->
    <color name="colorWidgetBg">#F6F7F9</color>        <!-- app.css bg token, light -->
    <color name="colorWidgetSurface">#E6E8ED</color>
    <color name="colorWidgetText">#1F2937</color>      <!-- app.css text token, light -->
    <color name="colorWidgetAccent">#575FCA</color>    <!-- app.css accent token, light -->
    <color name="colorWidgetMuted">#4B5563</color>   <!-- app.css muted token, light -->
</resources>
