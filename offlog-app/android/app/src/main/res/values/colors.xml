<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorPrimary">#5457e0</color>
    <color name="colorPrimaryDark">#181a20</color>
    <color name="colorAccent">#5457e0</color>

    <!-- Widget palette, matched to app.css's tokens. This file is the
         LIGHT set; the dark set is values-night/colors.xml. A widget
         renders outside the app's in-app theme setting, so it follows the
         system light/dark setting instead — both files must stay in sync
         with app.css's :root / body.dark blocks (docs/tech.md's Theme
         System table is the source of truth).
         colorWidgetBg/colorWidgetSurface deliberately deviate from
         app.css's light surface/bg (#FFFFFF/#F6F7F9): pure white reads as
         too stark against a real home-screen wallpaper. Dark mode uses the
         exact app.css values. -->
    <color name="colorWidgetBg">#FBF8F2</color>      <!-- warm cream, not app.css's exact surface token -->
    <!-- Keep a real, visible step away from colorWidgetBg. Within ~10/255
         per channel the two round action buttons stop reading as separate
         from the card in light mode; dark mode's equivalent gap is 2-3x
         bigger in relative terms, so it looks fine while light mode reads
         as flat. -->
    <color name="colorWidgetSurface">#E6DCC8</color>
    <color name="colorWidgetAccent">#5457E0</color>  <!-- app.css accent token, light -->
    <color name="colorWidgetText">#1F2937</color>    <!-- app.css text token, light -->
    <color name="colorWidgetMuted">#4B5563</color>   <!-- app.css muted token, light -->
</resources>
