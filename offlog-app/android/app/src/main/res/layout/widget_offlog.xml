<?xml version="1.0" encoding="utf-8"?>
<!-- The card fills the cell the launcher grants (2x2), like the system's
     own widgets. The two round buttons share the row by weight, so their
     corners (32dp on a 64dp height) make circles at the 2x2 width and
     stadiums if a launcher grants a wider cell. Keep
     widget_offlog_preview.xml's content in sync by hand. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/btn_focus"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="@string/widget_action_focus">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_focus"
                android:layout_marginEnd="10dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_action_focus"
                android:textColor="@color/colorWidgetText"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <FrameLayout
                android:id="@+id/btn_quickadd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="@string/widget_action_quickadd">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_add" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_dashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="@string/widget_action_home">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_home" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
