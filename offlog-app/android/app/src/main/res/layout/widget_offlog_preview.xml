<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview only. A copy of widget_offlog.xml with ONLY the
     root changed from match_parent to a fixed size: the picker measures a
     match_parent root against minWidth/minHeight (110x110dp), squishing the
     card into a canvas too narrow for the Focus pill's text.
     Keep the inner content in sync with widget_offlog.xml by hand.
     Size this close to the card's natural ~173x149dp content. The card is
     wrap_content, so a bigger frame only adds dead space around it, and the
     picker scales the whole frame to a thumbnail — extra space makes the
     card render smaller, not bigger. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="185dp"
    android:layout_height="155dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/ic_widget_focus"
                android:layout_marginEnd="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_action_focus"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/widget_button_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="@color/colorWidgetText"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_button_bg">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_grid" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
