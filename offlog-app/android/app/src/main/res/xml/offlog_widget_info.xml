<?xml version="1.0" encoding="utf-8"?>
<!-- minWidth/minHeight set the REAL on-device footprint (110x110dp = 2x2
     cells), not the picker preview. Never grow them to fix how the preview
     looks — that grows the placed widget to 3x3.
     Fix the preview through previewLayout instead: it points at a
     dedicated @layout/widget_offlog_preview with its own fixed 200x170dp
     root. Reusing @layout/widget_offlog there fails because its root is
     match_parent, which the picker measures against minWidth/minHeight and
     squishes into a canvas too narrow for the Focus pill's text.
     previewLayout and initialLayout are separate resources, so the
     preview's size never affects the placed widget.
     maxResizeWidth/maxResizeHeight are absent deliberately: both are inert
     when resizeMode="none". -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_offlog"
    android:previewLayout="@layout/widget_offlog_preview"
    android:widgetCategory="home_screen"
    android:description="@string/widget_offlog_description"
    android:resizeMode="none" />
