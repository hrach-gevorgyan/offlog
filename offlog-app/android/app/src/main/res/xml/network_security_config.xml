<?xml version="1.0" encoding="utf-8"?>
<!-- Base-config cleartext, never an IP allowlist. Android enforces this
     at the OS level, so a host that isn't listed fails before the request
     leaves the device, with no error surfaced in the app — and the sync
     host's LAN IP changes on any DHCP renewal or network switch. No TLS on
     LAN sync is an accepted tradeoff; see docs/decisions.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
