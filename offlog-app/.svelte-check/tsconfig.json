{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json"
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte-check/dist/src/svelte-jsx-v4.d.ts"
  ],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.js",
    "../src/**/*.svelte",
    "svelte/src/**/*.ts",
    "svelte/src/**/*.js",
    "svelte/src/**/*.d.svelte.ts"
  ],
  "exclude": [
    "../src/App.svelte",
    "../src/lib/AppLock.svelte",
    "../src/lib/ArchivedProjectsManager.svelte",
    "../src/lib/CalendarPicker.svelte",
    "../src/lib/CardDetail.svelte",
    "../src/lib/ConfirmDialog.svelte",
    "../src/lib/ConfirmPinGate.svelte",
    "../src/lib/CustomFieldManager.svelte",
    "../src/lib/CustomSelect.svelte",
    "../src/lib/DashboardView.svelte",
    "../src/lib/DeadlinesView.svelte",
    "../src/lib/FilterBar.svelte",
    "../src/lib/FocusView.svelte",
    "../src/lib/GlobalSearch.svelte",
    "../src/lib/KanbanBoard.svelte",
    "../src/lib/ListView.svelte",
    "../src/lib/NamePrompt.svelte",
    "../src/lib/PinStar.svelte",
    "../src/lib/QuickAdd.svelte",
    "../src/lib/SettingsPanel.svelte",
    "../src/lib/SpaceManager.svelte",
    "../src/lib/TagManager.svelte",
    "../src/lib/TaskHistoryPanel.svelte",
    "../src/lib/TimePicker.svelte",
    "../src/lib/TimeTravelView.svelte",
    "../src/lib/TrashView.svelte",
    "../src/lib/UpdateModal.svelte"
  ]
}