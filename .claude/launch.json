{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "offlog",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "offlog-app"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "offlog-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--prefix", "offlog-app", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "offlog-site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["offlog-app/node_modules/vite/bin/vite.js", "site", "--port", "4200", "--strictPort"],
      "port": 4200
    }
  ]
}
